[Unit]
Description=Xray Transparent Proxy
Documentation=https://github.com/XTLS/Xray-core
After=network-online.target nss-lookup.target
Wants=network-online.target

[Service]
Type=simple
User=xray
WorkingDirectory=/etc/xray
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_BIND_SERVICE CAP_NET_RAW
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_BIND_SERVICE CAP_NET_RAW
NoNewPrivileges=true

# Xray owns the dedicated local route in table 110.
ExecStartPre=+/bin/bash -c 'ip route show table 110 | grep -q "local default" || ip route add local 0.0.0.0/0 dev lo table 110'
ExecStartPre=+/bin/bash -c 'ip -6 route show table 110 | grep -q "local default" || ip -6 route add local ::/0 dev lo table 110'

# Xray also owns the dedicated nftables tables for transparent proxying.
ExecStartPre=+-/usr/sbin/nft delete table ip xray_v4
ExecStartPre=+-/usr/sbin/nft delete table ip6 xray_v6
ExecStartPre=+/usr/sbin/nft -f /etc/nftables/xray-tproxy.nft

ExecStart=/usr/bin/xray run -confdir /etc/xray/

Restart=on-failure
RestartSec=5

ExecStopPost=+/bin/bash -c 'ip route flush table 110 2>/dev/null || true'
ExecStopPost=+/bin/bash -c 'ip -6 route flush table 110 2>/dev/null || true'
ExecStopPost=+-/usr/sbin/nft delete table ip xray_v4
ExecStopPost=+-/usr/sbin/nft delete table ip6 xray_v6

ProtectHome=true
PrivateTmp=true
TimeoutStartSec=30
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
