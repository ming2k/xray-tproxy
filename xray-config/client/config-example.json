// XTLS/REALITY reference: https://github.com/XTLS/REALITY
// Xray installation: https://github.com/XTLS/Xray-install
{
  "log": {
    "loglevel": "info",
    "error": "/var/log/xray/error.log",
    "access": "/var/log/xray/access.log"
  },
  "dns": {
    "servers": [
      {
        "address": "localhost",
        "domains": [
          "geosite:private",
          "domain:local",
          "domain:lan",
          "domain:home.arpa",
          "domain:connectivitycheck.gstatic.com",
          "domain:captive.apple.com",
          "domain:detectportal.firefox.com",
          "domain:msftconnecttest.com",
          "domain:msftncsi.com"
        ],
        "skipFallback": true
      },
      {
        "address": "https://1.1.1.1/dns-query",
        "domains": [
          "geosite:geolocation-!cn",
          "geosite:google",
          "geosite:openai",
          "geosite:anthropic",
          "domain:z.ai"
        ]
      },
      {
        "address": "223.5.5.5",
        "domains": [
          "geosite:cn"
        ],
        "expectedIPs": [
          "geoip:cn"
        ]
      },
      "https://1.1.1.1/dns-query"
    ],
    "queryStrategy": "UseIPv4"
  },
  "inbounds": [
    {
      "tag": "all-in",
      "port": 12345,
      "protocol": "dokodemo-door",
      "settings": {
        "network": "tcp,udp",
        "followRedirect": true
      },
      "sniffing": {
        "enabled": true,
        "destOverride": ["http", "tls", "quic"],
        "routeOnly": true
      },
      "streamSettings": {
        "sockopt": {
          "tproxy": "tproxy"
        }
      }
    },
    {
      "tag": "socks-in",
      "listen": "127.0.0.1",
      "port": 1080,
      "protocol": "socks",
      "settings": {
        "auth": "noauth",
        "udp": true
      },
      "sniffing": {
        "enabled": true,
        "destOverride": ["http", "tls", "quic"],
        "routeOnly": true
      }
    }
  ],
  "outbounds": [
    {
      "protocol": "vless",
      "tag": "proxy",
      "settings": {
        "vnext": [
          {
            "address": "<SERVER_IP:203.0.113.10>",
            "port": 10443,
            "users": [
              {
                "id": "<UUID:a1b2c3d4-e5f6-7890-abcd-ef1234567890>",
                "encryption": "none",
                "flow": "xtls-rprx-vision"
              }
            ]
          }
        ]
      },
      "streamSettings": {
        "network": "tcp",
        "security": "reality",
        "realitySettings": {
          "show": false,
          "fingerprint": "chrome",
          "serverName": "<SERVER_NAME:example.com>",
          "publicKey": "<PUBLIC_KEY:REDACTED_PUBLIC_KEY>",
          "shortId": "<SHORT_ID:0123456789abcdef>",
          "spiderX": "/"
        },
        "sockopt": {
          "mark": 2,
          "tcpKeepAliveIdle": 15,
          "tcpKeepAliveInterval": 5
        }
      }
    },
    {
      "protocol": "freedom",
      "tag": "direct",
      "settings": {
        "domainStrategy": "UseIPv4v6"
      },
      "streamSettings": {
        "sockopt": {
          "mark": 2,
          "tcpKeepAliveIdle": 15,
          "tcpKeepAliveInterval": 5
        }
      }
    },
    {
      "protocol": "dns",
      "tag": "dns-out"
    },
    {
      "protocol": "blackhole",
      "tag": "blocked"
    }
  ],
  "routing": {
    "domainStrategy": "IPIfNonMatch",
    "rules": [
      {
        "type": "field",
        "inboundTag": [
          "all-in",
          "socks-in"
        ],
        "port": 53,
        "outboundTag": "dns-out"
      },
      {
        "type": "field",
        "ip": ["<SERVER_IP:203.0.113.10>"],
        "outboundTag": "direct"
      },
      {
        "type": "field",
        "protocol": [ "bittorrent" ],
        "outboundTag": "direct"
      },
      {
        "type": "field",
        "ip": ["geoip:private"],
        "outboundTag": "direct"
      },
      {
        "type": "field",
        "domain": [
          "geosite:google",
          "geosite:openai",
          "geosite:anthropic",
          "domain:z.ai"
        ],
        "outboundTag": "proxy"
      },
      {
        "type": "field",
        "domain": [
          "geosite:private",
          "geosite:cn",
          "domain:connectivitycheck.gstatic.com",
          "domain:captive.apple.com",
          "domain:detectportal.firefox.com",
          "domain:msftconnecttest.com",
          "domain:msftncsi.com"
        ],
        "outboundTag": "direct"
      },
      {
        "type": "field",
        "ip": ["geoip:cn"],
        "outboundTag": "direct"
      },
      {
        "type": "field",
        "network": "tcp,udp",
        "outboundTag": "proxy"
      }
    ]
  }
}
// vim: set ft=jsonc:

